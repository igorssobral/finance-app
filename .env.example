# Banco de dados (PostgreSQL)
# Preencha com seus próprios valores locais; nunca commite este arquivo com segredos reais.
DATABASE_URL="postgresql://user:password@host:5432/db"
DIRECT_URL="postgresql://user:password@host:5432/db"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT (rotas de API custom, se necessário)
JWT_SECRET="change-me"

# Upload de comprovantes (Vercel Blob ou S3-compatible)
BLOB_READ_WRITE_TOKEN=""

# IA (categorização automática, assistente em linguagem natural)
ANTHROPIC_API_KEY=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Ambiente
NODE_ENV="development"
